# ---------------------------------------------------------------------------
# Instagram AI Agent — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Anthropic / Claude ---
# Leave ANTHROPIC_API_KEY unset if you authenticate via `ant auth login`.
ANTHROPIC_API_KEY=
# Default per Anthropic guidance. For a high-volume, cost-sensitive DM workload
# you can switch to claude-sonnet-5 ($2/$10 per 1M vs $5/$25) — measure quality first.
CLAUDE_MODEL=claude-opus-5

# --- Meta / Instagram (from docs/01-instagram-business-account-setup.md) ---
# A string YOU invent; must match what you enter in the Meta webhook dashboard.
WEBHOOK_VERIFY_TOKEN=change-me-to-a-random-string
# App → Settings → Basic. Used to verify X-Hub-Signature-256 on webhooks.
META_APP_SECRET=
# Long-lived access token used to call the Send API.
INSTAGRAM_ACCESS_TOKEN=
# The Instagram professional account's ID (the "me" for Send API calls).
INSTAGRAM_ACCOUNT_ID=
# Graph API version to target.
GRAPH_API_VERSION=v21.0

# --- Calendly ---
# Simplest POC path: just share this scheduling link in the DM.
CALENDLY_SCHEDULING_URL=https://calendly.com/your-handle/consultation

# --- Business ---
BUSINESS_NAME=Your Jewelry Studio
BUSINESS_CURRENCY=USD

# --- App ---
DATABASE_PATH=data/agent.db
LOG_LEVEL=INFO
